# Add entries for your own language once you decide it in Stage 3
# (for example __pycache__/ for Python, node_modules/ for JavaScript).

# HVE Core session evidence.
# The helpers write research, plans, changes and review logs here while they
# work. HVE Core treats this as scratch space and ignores it by default.
# If your team wants the evidence trail committed, delete the two lines below.
.copilot-tracking/*
!.copilot-tracking/.gitkeep

# Secrets — never commit these
.env
.env.*
*.pem
*.key

# Local databases and data files
*.db
*.sqlite
*.sqlite3

# Build and dependency folders
dist/
build/
node_modules/

# Virtual environments
.venv/
venv/
env/

# Editor and operating system files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs and caches
*.log
.cache/
